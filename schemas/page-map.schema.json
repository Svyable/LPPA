{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svyable.github.io/LPPA/schemas/page-map.schema.json",
  "title": "Interior page map",
  "type": "object",
  "required": [
    "schema_version",
    "book_slug",
    "page_count",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "book_slug": {
      "type": "string"
    },
    "page_count": {
      "type": "integer",
      "minimum": 0
    },
    "trim_inches": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "bleed": {
      "type": "boolean"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "side",
          "type",
          "content"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "type": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  }
}
